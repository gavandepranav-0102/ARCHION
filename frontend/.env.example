# Optional: use when the backend is not running at http://127.0.0.1:5000.
# This value configures the Vite development/preview proxy target.
VITE_BACKEND_URL=http://127.0.0.1:5000

# Optional only when frontend calls a separately deployed API directly.
# Example: VITE_API_BASE_URL=https://api.example.com/api
# VITE_API_BASE_URL=/api
